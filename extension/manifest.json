{
  "manifest_version": 3,
  "name": "NEO Meme Coins",
  "version": "0.6.0",
  "description": "Autonomous device-first Solana Sentinel for Fomo, Axiom and Photon with nonstop 3s market flow, 15s holder pulse, automatic deep forensics, public social/web observation and local validation.",
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": [
    "https://api.dexscreener.com/*",
    "https://api.mainnet.solana.com/*",
    "https://api.mainnet-beta.solana.com/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background-main.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fomo.family/*",
        "https://*.fomo.family/*",
        "https://photon-sol.tinyastro.io/*",
        "https://photon.tinyastro.io/*",
        "https://axiom.trade/*",
        "https://backup.axiom.trade/*"
      ],
      "js": ["fomo-discovery.js", "sentinel-v2.js", "realtime-layer.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "NEO Meme Coins Sentinel",
    "default_popup": "popup.html"
  }
}
