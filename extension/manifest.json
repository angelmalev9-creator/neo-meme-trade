{
  "manifest_version": 3,
  "name": "NEO Meme Coins",
  "version": "0.4.2",
  "description": "Autonomous device-first Solana Sentinel for Fomo, Axiom and Photon: page-wide radar, visible-symbol resolution, selective deep checks, holders, wallet funding, socials, narratives and momentum evidence.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://api.dexscreener.com/*",
    "https://api.mainnet.solana.com/*",
    "https://api.mainnet-beta.solana.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fomo.family/*",
        "https://*.fomo.family/*",
        "https://photon-sol.tinyastro.io/*",
        "https://photon.tinyastro.io/*",
        "https://axiom.trade/*",
        "https://backup.axiom.trade/*"
      ],
      "js": ["fomo-discovery.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "NEO Meme Coins Sentinel",
    "default_popup": "popup.html"
  }
}
