{
  "manifest_version": 3,
  "name": "NEO Meme Coins",
  "version": "0.1.0",
  "description": "Device-first Solana meme coin risk intelligence: liquidity, holders, fresh-wallet sampling and deterministic risk signals.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "https://api.dexscreener.com/*",
    "https://api.mainnet.solana.com/*",
    "https://api.mainnet-beta.solana.com/*"
  ],
  "optional_host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "NEO Meme Coins",
    "default_popup": "popup.html"
  }
}
