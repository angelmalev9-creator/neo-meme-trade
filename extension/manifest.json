{
  "manifest_version": 3,
  "name": "NEO Meme Coins",
  "version": "0.7.0",
  "description": "Autonomous multichain realtime crypto Sentinel for Fomo, Axiom and Photon: Solana, Robinhood Chain, Base, Ethereum, BNB Chain and Monad discovery, market radar, automatic deep analysis, social observation and local validation.",
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": [
    "https://api.dexscreener.com/*",
    "https://api.mainnet.solana.com/*",
    "https://api.mainnet-beta.solana.com/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background-main-v2.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://fomo.family/*",
        "https://*.fomo.family/*",
        "https://photon-sol.tinyastro.io/*",
        "https://photon.tinyastro.io/*",
        "https://axiom.trade/*",
        "https://backup.axiom.trade/*"
      ],
      "js": ["sentinel-v3.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "NEO Meme Coins Sentinel",
    "default_popup": "popup.html"
  }
}
