# Install as /etc/neo/neo-x-signal.env with chmod 600.
# Never commit a real xAI key.
XAI_API_KEY=xai_REPLACE_ME
NEO_X_SIGNAL_HANDLES=elonmusk
NEO_X_SIGNAL_POLL_SECONDS=120
NEO_X_SIGNAL_DAILY_BUDGET_USD=2.00
NEO_X_SIGNAL_MODEL=grok-4.3
NEO_X_SIGNAL_MAX_AGE_SECONDS=600
NEO_X_SIGNAL_STATE_PATH=/var/lib/neo-market/x_signal.json
NEO_X_SIGNAL_REQUEST_TIMEOUT_SECONDS=30
