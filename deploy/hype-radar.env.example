# Install as /etc/neo/neo-hype-radar.env with chmod 600. Never commit a real key.
# Any OpenAI-compatible chat endpoint works; xAI is the default because the owner has a key.
NEO_HYPE_LLM_KEY=xai_REPLACE_ME
NEO_HYPE_LLM_URL=https://api.x.ai/v1/chat/completions
NEO_HYPE_LLM_MODEL=grok-4.1-fast-non-reasoning
# Prices per million tokens, used only for the daily budget accounting.
NEO_HYPE_INPUT_MTOKEN_USD=0.20
NEO_HYPE_OUTPUT_MTOKEN_USD=0.50
NEO_HYPE_DAILY_BUDGET_USD=1.00
NEO_HYPE_POLL_SECONDS=900
NEO_HYPE_THEME_TTL_SECONDS=10800
NEO_HYPE_MIN_HYPE=40
NEO_HYPE_STATE_PATH=/var/lib/neo-market/hype_radar.json
