[Unit]
Description=NEO Angel PAPER verified read-only live trade stream
After=network-online.target neo-user-angel-paper.service
Wants=network-online.target
[Service]
Type=simple
User=root
WorkingDirectory=/root/neo-meme-trade
Environment=NODE_ENV=production
Environment=NEO_LOCAL_API=http://127.0.0.1:18804/state
Environment=NEO_STREAM_OUT=/var/lib/neo-market/users/42d3192d-f033-4061-85d6-2408c5e168e7/live_tape_stream_paper.json
Environment=NEO_STREAM_MAX_POOLS=12
Environment=NEO_STREAM_MAX_EVENTS=800
ExecStart=/root/.nvm/versions/node/v22.23.2/bin/node /root/neo-meme-trade/backend/live_tape_stream_paper.cjs
Restart=always
RestartSec=4
LimitNOFILE=8192
[Install]
WantedBy=multi-user.target
